# =============================================================================
# Necly Services Frontend - Environment Variables
# =============================================================================
# This file lists ALL environment variables used by the frontend.
# Copy to .env.local and fill in values for local development.
#
# PRODUCTION REQUIREMENTS:
# - All NEXT_PUBLIC_* variables MUST be set to real values in production.
# - No real secrets should appear in this file or any .env file committed to git.
# - Production secrets (if any frontend needs) must be injected via secure runtime
#   mechanisms (e.g., Docker secrets, Kubernetes secrets, platform env).
# =============================================================================

# -----------------------------------------------------------------------------
# API & Site Configuration (REQUIRED in production)
# -----------------------------------------------------------------------------
# Base URL of the Necly backend API (include /api/v1 or path prefix as needed)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Public base URL of this frontend (used for absolute URLs, sitemap, canonicals)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Force seed data fallback and sandbox payment flow (true/false)
# When true: UI reads from src/data/seed.ts, no API calls; checkout/payment are sandbox
# When false or unset: UI calls real API at NEXT_PUBLIC_API_URL
NEXT_PUBLIC_DEMO_MODE=false

# -----------------------------------------------------------------------------
# Optional: Analytics / Monitoring (set in production only)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_SENTRY_DSN=

# -----------------------------------------------------------------------------
# Optional: Feature Flags (development overrides)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_ENABLE_EXPERIMENTAL_FEATURES=false